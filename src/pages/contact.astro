---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Contact us | rotpunkt.dev" description="Tell rotpunkt.dev about your next website project.">
	<SiteHeader />
	<main>
		<p class="eyebrow">Contact us</p>
		<h1>Let’s make<br /><em>something good.</em></h1>
		<p class="intro">Tell us a little about what you are working on. We’ll get back to you as soon as possible.</p>

		{sent && <p class="notice success" role="status">Thanks for reaching out. Your message is on its way.</p>}
		{error === 'validation' && <p class="notice error" role="alert">Please add your name, a valid email address and a message.</p>}
		{error === 'server' && <p class="notice error" role="alert">Something went wrong while sending your message. Please try again or email us directly.</p>}

		<form method="POST" action="/api/contact">
			<div class="field"><label for="name">Name <span aria-hidden="true">*</span></label><input id="name" name="name" type="text" autocomplete="name" required /></div>
			<div class="field"><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" required /></div>
			<div class="field"><label for="message">Message <span aria-hidden="true">*</span></label><textarea id="message" name="message" rows="7" required></textarea></div>
			<div class="honeypot" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
			<button type="submit">Send<span aria-hidden="true">↗</span></button>
			<p class="form-note">By submitting this form, you agree that we may use your details to respond. See our <a href="/privacy">privacy policy</a>.</p>
		</form>
	</main>
	<SiteFooter />
</Layout>

<style>
	main { width: min(calc(100% - 3rem), 58rem); margin: 0 auto; padding: 7rem 0 2rem; }
	.eyebrow { margin: 0 0 1rem; color: var(--muted); font: 700 .75rem/1.2 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
	h1 { margin: 0; font-size: clamp(4rem, 10vw, 8rem); font-weight: 800; letter-spacing: -.07em; line-height: .94; } h1 em { color: var(--violet); font-style: normal; }
	.intro { max-width: 34rem; margin: 2rem 0 4rem; color: var(--muted); font-size: 1.2rem; line-height: 1.6; }
	form { display: grid; gap: 1.5rem; } .field { display: grid; gap: .55rem; } label { font-weight: 750; } label span { color: var(--violet); } input, textarea { width: 100%; padding: .9rem 1rem; color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: .35rem; } textarea { resize: vertical; min-height: 10rem; } input:focus, textarea:focus { outline: 3px solid color-mix(in srgb, var(--violet) 35%, transparent); outline-offset: 2px; border-color: var(--violet); } button { justify-self: start; padding: .9rem 1.2rem; border: 0; border-radius: 999px; background: var(--ink); color: var(--paper); font: inherit; font-weight: 800; cursor: pointer; } :global(:root[data-theme='dark']) button { background: var(--acid); color: #171717; } .form-note { margin: 0; color: var(--muted); font-size: .8rem; line-height: 1.5; } .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); } .notice { margin: 0 0 2rem; padding: 1rem 1.2rem; border-left: .35rem solid var(--violet); line-height: 1.5; } .success { background: color-mix(in srgb, var(--acid) 45%, transparent); } .error { background: color-mix(in srgb, #e32119 15%, transparent); }
	@media (max-width: 720px) { main { width: min(calc(100% - 1.5rem), 58rem); padding-top: 4rem; } .intro { margin-bottom: 3rem; } }
</style>
