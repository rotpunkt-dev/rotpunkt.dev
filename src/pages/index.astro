---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { projects } from '../data/projects';
---

<Layout>
	<SiteHeader />
	<main id="main-content">
		<section class="hero">
			<p class="kicker">Independent web agency</p>
			<h1>Websites<br /><em>light</em> and <em>fast.</em></h1>
		</section>

		<section class="work" id="work" aria-labelledby="work-heading">
			<div class="section-head"><p class="kicker">Selected work</p><h2 id="work-heading">Built around the<br />people behind it.</h2></div>
			<div class="project-grid">
				{projects.map((project) => (
					<a class={`project ${project.colour}`} href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit the ${project.name} website`}>
						<div class="project-meta"><span>{project.name}</span><span>{project.discipline}</span></div>
						<h3>{project.title}</h3>
						<p class="project-stack">{project.techStack.join(' · ')}</p>
						<img src={project.image} alt={project.alt} width="1200" height="800" loading="lazy" decoding="async" />
					</a>
				))}
			</div>
		</section>

		<section class="services" id="services" aria-labelledby="services-heading">
			<p class="kicker">What we do</p>
			<h2 id="services-heading">From the first question<br />to a site that lasts.</h2>
			<div class="service-list">
				<div><span>01</span><h3>Strategy &amp; structure</h3><p>Finding the story, audience and shape that make a website useful.</p></div>
				<div><span>02</span><h3>Identity &amp; interface</h3><p>Giving every project a clear visual voice and an effortless path through it.</p></div>
				<div><span>03</span><h3>Development &amp; care</h3><p>Building fast, flexible sites that are straightforward to run and evolve.</p></div>
			</div>
		</section>

		<section class="about" id="about">
			<p class="kicker">About rotpunkt.dev</p>
			<div><h2>Small enough to care about every detail. Experienced enough to know which ones count.</h2><p>We work closely with clients to turn complex ideas into clear, distinctive websites. No unnecessary layers, no black boxes: just thoughtful design and reliable development, working together.</p><a href="mailto:hello@rotpunkt.dev">Let’s talk about your project <span aria-hidden="true">↗</span></a></div>
		</section>
	</main>
	<SiteFooter />
</Layout>

<style>
	main { overflow: hidden; } .hero, .work, .services, .about { width: min(calc(100% - 3rem), 78rem); margin: 0 auto; }
	.hero { min-height: 72vh; padding: clamp(5rem, 11vw, 10rem) 0 5rem; display: grid; align-content: start; }
	.kicker { margin: 0 0 1.15rem; font: 700 .75rem/1.2 ui-monospace, monospace; letter-spacing: .09em; text-transform: uppercase; color: var(--muted); }
	h1, h2, h3, p { margin-top: 0; } h1, h2 { letter-spacing: -.07em; line-height: .94; font-weight: 800; } h1 { font-size: clamp(4rem, 10vw, 9rem); } h1 em { color: var(--violet); font-style: normal; }
	.intro { margin-top: clamp(3rem, 9vw, 8rem); display: flex; gap: 2rem; align-items: end; justify-content: space-between; max-width: 58rem; } .intro p { max-width: 35rem; font-size: clamp(1.15rem, 2vw, 1.6rem); line-height: 1.45; } .intro a, .about a { font-weight: 800; text-decoration-thickness: 1px; text-underline-offset: .25em; white-space: nowrap; }
	.work { padding-top: 3rem; } .section-head { display: grid; grid-template-columns: 1fr 2fr; padding-bottom: 2.5rem; } h2 { font-size: clamp(2.8rem, 6vw, 5.5rem); }
	.project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; } .project { min-height: 31rem; padding: 1.5rem; display: flex; flex-direction: column; border-radius: 1.5rem; overflow: hidden; color: var(--ink); text-decoration: none; transition: transform .16s ease, box-shadow .16s ease; } .project:hover { transform: translateY(-.35rem); box-shadow: 0 1.25rem 2.5rem rgba(23,23,23,.12); } .project.acid { background: var(--acid); } .project.violet { background: #d4c7ff; } .project.coral { background: #ff9d7c; } .project.blue { background: #8fcae6; } :global(:root[data-theme='dark']) .project.acid { background: #b9d83d; color: #171717; } :global(:root[data-theme='dark']) .project.violet { background: #a18cff; color: #171717; } :global(:root[data-theme='dark']) .project.coral, :global(:root[data-theme='dark']) .project.blue { color: #171717; } .project-meta { display: flex; justify-content: space-between; gap: 1rem; font: 700 .69rem/1.2 ui-monospace, monospace; letter-spacing: .04em; text-transform: uppercase; } .project h3 { max-width: 29rem; margin: 2rem 0 1rem; font-size: clamp(1.55rem, 2.8vw, 2.5rem); letter-spacing: -.055em; line-height: 1.05; } .project-stack { margin: 0 0 1.5rem; color: #171717; font: 700 .72rem/1.3 ui-monospace, monospace; letter-spacing: .04em; text-transform: uppercase; opacity: 1; } .project img { width: 100%; height: 16rem; object-fit: cover; object-position: top; border-radius: .85rem; box-shadow: 0 .8rem 1.7rem rgba(0,0,0,.17); }
	@media (min-width: 721px) { .project { min-height: 38rem; } .project img { height: 20rem; } }
	.services { padding: 10rem 0; } .services > h2 { margin-bottom: 4rem; } .service-list { border-top: 1px solid var(--line); } .service-list > div { display: grid; grid-template-columns: 10rem 1.25fr 1fr; gap: 1.5rem; padding: 1.75rem 0; border-bottom: 1px solid var(--line); } .service-list span { font: 700 .75rem ui-monospace, monospace; color: var(--muted); } .service-list h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.04em; } .service-list p { margin: 0; color: var(--muted); line-height: 1.5; }
	.about { padding: 5rem 0; display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; border-top: 1px solid var(--line); } .about h2 { font-size: clamp(2.25rem, 4.2vw, 4rem); } .about p { max-width: 38rem; margin: 2rem 0; font-size: 1.15rem; line-height: 1.6; color: var(--muted); }
	@media (max-width: 720px) { .hero, .work, .services, .about { width: min(calc(100% - 1.5rem), 78rem); } .hero { min-height: 65vh; } .intro, .section-head, .about { display: block; } .intro a { display: inline-block; } .section-head .kicker { margin-bottom: 2rem; } .project-grid { grid-template-columns: 1fr; gap: 1rem; } .project { min-height: 0; padding: 1rem; border-radius: 1rem; } .project-meta { align-items: flex-start; font-size: .62rem; } .project-meta span:last-child { max-width: 8rem; text-align: right; } .project h3 { margin: 1.5rem 0 .75rem; font-size: clamp(1.65rem, 8vw, 2.25rem); line-height: 1.02; } .project-stack { margin-bottom: 1.25rem; font-size: .65rem; } .project img { height: auto; aspect-ratio: 3 / 2; border-radius: .65rem; } .services { padding: 7rem 0; } .service-list > div { grid-template-columns: 3rem 1fr; } .service-list p { grid-column: 2; } .about { padding-top: 4rem; } }
</style>
